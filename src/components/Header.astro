---
// src/components/Header.astro
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header 
  id="main-header"
  class="bg-white/95 backdrop-blur-md border-b border-slate-100 fixed top-0 left-0 w-full z-50 shadow-sm transition-transform duration-300 ease-in-out"
>
  <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
    
    <!-- Logo -->
    <a href={`${baseUrl}/`} class="inline-block transition-transform duration-200 hover:scale-[1.02] active:scale-95">
      <img src="Sdent.jpg" alt="Logo SDent" width="180" height="60" class="cursor-pointer select-none object-contain h-auto" />
    </a>

    <!-- Menú Desktop -->
    <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-700">
      <a href={`${baseUrl}/`} class="transition-colors duration-200 hover:text-[#01B4FF]">Inicio</a>
      <a href={`${baseUrl}/consultorio/`} class="transition-colors duration-200 hover:text-[#01B4FF]">Consultorio</a>
      <a href={`${baseUrl}/servicios/`} class="transition-colors duration-200 hover:text-[#01B4FF]">Servicios</a>
      <a href={`${baseUrl}/contacto/`} class="transition-colors duration-200 hover:text-[#01B4FF]">Contacto</a>
    </nav>

    <!-- Acciones -->
    <div class="flex items-center gap-3">
      <!-- Botón Agendar Cita (Oculto estricto en celular con !hidden) -->
      <a 
        href="https://wa.me/573136834065" 
        target="_blank" 
        rel="noopener noreferrer"
        class="!hidden md:!inline-block bg-[#01B4FF] hover:bg-[#e5007d] text-white font-semibold px-5 py-2.5 rounded-md text-sm transition-all duration-200 hover:shadow-md active:scale-95"
      >
        Agendar Cita
      </a>

      <!-- Botón Hamburguesa (Visible únicamente en celular) -->
      <button 
        id="menu-toggle"
        aria-label="Abrir menú"
        class="md:hidden text-slate-700 hover:text-[#01B4FF] p-2 focus:outline-none transition-transform duration-200 active:scale-90"
      >
        <svg id="hamburger-icon" class="w-7 h-7 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

  </div>

  <!-- Menú Desplegable Móvil (Forzado a la derecha) -->
  <div 
    id="mobile-menu" 
    class="hidden md:hidden bg-white/98 border-b border-slate-100 px-6 py-4 space-y-3 flex flex-col items-end text-right shadow-lg transition-all duration-300 ease-in-out opacity-0 -translate-y-2"
  >
    <a href={`${baseUrl}/`} class="block w-full text-right text-slate-700 hover:text-[#01B4FF] font-semibold text-base py-1 transition-colors">Inicio</a>
    <a href={`${baseUrl}/consultorio/`} class="block w-full text-right text-slate-700 hover:text-[#01B4FF] font-semibold text-base py-1 transition-colors">Consultorio</a>
    <a href={`${baseUrl}/servicios/`} class="block w-full text-right text-slate-700 hover:text-[#01B4FF] font-semibold text-base py-1 transition-colors">Servicios</a>
    <a href={`${baseUrl}/contacto/`} class="block w-full text-right text-slate-700 hover:text-[#01B4FF] font-semibold text-base py-1 transition-colors">Contacto</a>
  </div>
</header>

<!-- Espaciador fija la altura para evitar solapamientos -->
<div class="h-20"></div>

<script>
  function setupHeader() {
    const toggleBtn = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const header = document.getElementById('main-header');

    let isMenuOpen = false;

    function toggleMobileMenu(forceClose = false) {
      if (!mobileMenu) return;

      if (forceClose || isMenuOpen) {
        mobileMenu.classList.add('opacity-0', '-translate-y-2');
        setTimeout(() => {
          mobileMenu.classList.add('hidden');
        }, 200);
        isMenuOpen = false;
      } else {
        mobileMenu.classList.remove('hidden');
        setTimeout(() => {
          mobileMenu.classList.remove('opacity-0', '-translate-y-2');
        }, 10);
        isMenuOpen = true;
      }
    }

    if (toggleBtn) {
      // Remover oyentes anteriores si los hubiera
      const newToggleBtn = toggleBtn.cloneNode(true);
      toggleBtn.parentNode?.replaceChild(newToggleBtn, toggleBtn);

      newToggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMobileMenu();
      });
    }

    let lastScrollY = window.scrollY;

    window.addEventListener('scroll', () => {
      if (!header) return;

      const currentScrollY = window.scrollY;

      if (currentScrollY > lastScrollY && currentScrollY > 50) {
        if (isMenuOpen) {
          toggleMobileMenu(true);
        }
        header.classList.add('-translate-y-full');
      } else if (currentScrollY < lastScrollY) {
        header.classList.remove('-translate-y-full');
      }

      lastScrollY = currentScrollY;
    });
  }

  // Ejecución inicial y compatibilidad con navegación Astro
  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
</script>