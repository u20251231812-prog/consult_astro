---
// src/components/Header.astro
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="bg-white/90 backdrop-blur-md border-b border-slate-100 sticky top-0 z-50 shadow-sm font-sans">
  <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
    
    <!-- Logo -->
    <a href={`${baseUrl}/`} class="inline-block transition-transform duration-200 hover:scale-[1.02] active:scale-95">
      <img src="Sdent.jpg" alt="Logo SDent" width="180" height="60" class="cursor-pointer select-none object-contain h-auto" />
    </a>

    <!-- Menú Desktop (Oculto en celular 'hidden', visible en 'md:flex') -->
    <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-700">
      <a href={`${baseUrl}/`} class="transition-colors duration-200 hover:text-[#01B4FF]">Inicio</a>
      <a href={`${baseUrl}/consultorio/`} class="transition-colors duration-200 hover:text-[#01B4FF]">Consultorio</a>
      <a href={`${baseUrl}/servicios/`} class="transition-colors duration-200 hover:text-[#01B4FF]">Servicios</a>
      <a href={`${baseUrl}/contacto/`} class="transition-colors duration-200 hover:text-[#01B4FF]">Contacto</a>
    </nav>

    <!-- Acciones en Celular / Desktop -->
    <div class="flex items-center gap-3">
      <!-- Botón Agendar Cita (Siempre visible) -->
      <a 
        href="https://wa.me/573136834065" 
        target="_blank" 
        rel="noopener noreferrer"
        class="bg-[#01B4FF] hover:bg-[#e5007d] text-white font-semibold px-4 py-2 sm:px-5 sm:py-2.5 rounded-md text-xs sm:text-sm transition-all duration-200 hover:shadow-md active:scale-95 inline-block"
      >
        Agendar Cita
      </a>

      <!-- Botón Hamburguesa (Solo visible en celular 'md:hidden') -->
      <button 
        id="menu-toggle"
        aria-label="Abrir menú"
        class="md:hidden text-slate-700 hover:text-[#01B4FF] p-2 focus:outline-none"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

  </div>

  <!-- Menú Desplegable Móvil -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-slate-100 px-6 py-4 space-y-3">
    <a href={`${baseUrl}/`} class="block text-slate-700 hover:text-[#01B4FF] font-medium text-sm py-1">Inicio</a>
    <a href={`${baseUrl}/consultorio/`} class="block text-slate-700 hover:text-[#01B4FF] font-medium text-sm py-1">Consultorio</a>
    <a href={`${baseUrl}/servicios/`} class="block text-slate-700 hover:text-[#01B4FF] font-medium text-sm py-1">Servicios</a>
    <a href={`${baseUrl}/contacto/`} class="block text-slate-700 hover:text-[#01B4FF] font-medium text-sm py-1">Contacto</a>
  </div>
</header>

<script>
  // Script ejecutable del lado del cliente para alternar la visibilidad
  const toggleBtn = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>