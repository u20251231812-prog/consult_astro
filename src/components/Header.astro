---
// src/components/Header.astro
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header 
  id="main-header"
  class="bg-white/95 backdrop-blur-md border-b border-slate-100 fixed top-0 left-0 w-full z-50 shadow-sm transition-transform duration-300 ease-in-out"
>
  <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
    
    <!-- Logo -->
    <a href={`${baseUrl}/`} class="inline-block transition-transform duration-200 hover:scale-[1.02] active:scale-95">
      <img src="Sdent.jpg" alt="Logo SDent" width="180" height="60" class="cursor-pointer select-none object-contain h-auto" />
    </a>

    <!-- Menú Desktop -->
    <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-700">
      <a href={`${baseUrl}/`} class="transition-colors duration-200 hover:text-[#01B4FF]">Inicio</a>
      <a href={`${baseUrl}/consultorio/`} class="transition-colors duration-200 hover:text-[#01B4FF]">Consultorio</a>
      <a href={`${baseUrl}/servicios/`} class="transition-colors duration-200 hover:text-[#01B4FF]">Servicios</a>
      <a href={`${baseUrl}/contacto/`} class="transition-colors duration-200 hover:text-[#01B4FF]">Contacto</a>
    </nav>

    <!-- Acciones -->
    <div class="flex items-center gap-3">
      <!-- Botón Agendar Cita (Oculto en celular 'hidden', visible en pantalla grande 'md:inline-block') -->
      <a 
        href="https://wa.me/573136834065" 
        target="_blank" 
        rel="noopener noreferrer"
        class="hidden md:inline-block bg-[#01B4FF] hover:bg-[#e5007d] text-white font-semibold px-5 py-2.5 rounded-md text-sm transition-all duration-200 hover:shadow-md active:scale-95"
      >
        Agendar Cita
      </a>

      <!-- Botón Hamburguesa (Solo visible en celular) -->
      <button 
        id="menu-toggle"
        aria-label="Abrir menú"
        class="md:hidden text-slate-700 hover:text-[#01B4FF] p-2 focus:outline-none"
      >
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

  </div>

  <!-- Menú Desplegable Móvil (Alineado a la derecha) -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-slate-100 px-6 py-4 space-y-3 text-right">
    <a href={`${baseUrl}/`} class="block text-slate-700 hover:text-[#01B4FF] font-medium text-sm py-1">Inicio</a>
    <a href={`${baseUrl}/consultorio/`} class="block text-slate-700 hover:text-[#01B4FF] font-medium text-sm py-1">Consultorio</a>
    <a href={`${baseUrl}/servicios/`} class="block text-slate-700 hover:text-[#01B4FF] font-medium text-sm py-1">Servicios</a>
    <a href={`${baseUrl}/contacto/`} class="block text-slate-700 hover:text-[#01B4FF] font-medium text-sm py-1">Contacto</a>
  </div>
</header>

<!-- Compensación de margen superior para compensar el header fijo -->
<div class="h-20"></div>

<script>
  // 1. Alternar visibilidad del menú móvil
  const toggleBtn = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  // 2. Ocultar header al bajar / Mostrar al subir
  let lastScrollY = window.scrollY;
  const header = document.getElementById('main-header');

  window.addEventListener('scroll', () => {
    if (!header) return;

    const currentScrollY = window.scrollY;

    // Solo ocultar si el menú móvil está cerrado
    if (mobileMenu && mobileMenu.classList.contains('hidden')) {
      if (currentScrollY > lastScrollY && currentScrollY > 80) {
        // Desplazando hacia abajo -> Ocultar header
        header.classList.add('-translate-y-full');
      } else {
        // Desplazando hacia arriba -> Mostrar header
        header.classList.remove('-translate-y-full');
      }
    }

    lastScrollY = currentScrollY;
  });
</script>