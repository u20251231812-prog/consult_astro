---
import Sdent from "./Sdent.jpg";
---

<div class="min-h-screen bg-slate-50 text-slate-800 font-mono">
    <!-- 1. Header con Logo Más Grande y Colores Armónicos -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm font-serif" >
        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
            <!-- Logo Agrandado -->
            <a href="#inicio" class="inline-block transition-transform duration-200 ease-in-out hover:scale-[1.02] active:scale-95">    
                <img src="./Sdent.jpg" alt="Logo" width="220" height="70" class="cursor-pointer select-none object-contain h-auto w-55"/>
            </a>

            <!-- Menú de Navegación -->
            <nav class="hidden md:flex gap-8 text-base font-semibold text-slate-700 transition-all *:duration-200 *:hover:-translate-y-1">
                <a href="#inicio" class="hover:text-[#e5007d]"> 
                    Inicio
                </a>

                <a
                    href="#especialidades"
                    class="hover:text-[#e5007d] "
                >
                    Especialidades
                </a>

                <a href="#contacto" class="hover:text-[#e5007d]">
                    Contacto
                </a>
            </nav>

            <!-- Botón CTA Header -->
            <a
                href="tel:3112131914"
                class="bg-[#e5007d] hover:bg-[#c4006b] text-white font-bold text-sm px-6 py-3 rounded-full transition-transform duration-200 shadow-md shadow-[#e5007d]/20 hover:scale-105"
            >
                Agenda tu cita
            </a>
        </div>
    </header>

    <!-- 2. Hero Section Principal -->
    <section
        id="inicio"
        class="max-w-7xl mx-auto px-6 py-12 md:py-20 grid md:grid-cols-2 gap-12 items-center"
    >
        <div>
            <!-- Badge -->
            <span class="inline-block bg-[#00a3e0]/10 text-[#00a3e0] font-bold text-xs px-4 py-1.5 rounded-full mb-4 border border-[#00a3e0]/20">
                Atención Especializada en Bogotá
            </span>

            <h1 class="text-4xl md:text-5xl font-black text-slate-900 leading-tight mb-4">
                Endodoncia: <br />
                <span class="text-[#e5007d]">Salva tu diente</span>, alivia tu
                dolor.
            </h1>

            <p class="text-slate-600 text-base mb-8 leading-relaxed">
                Tratamiento de conductos con tecnología de precisión y atención
                cálida, humana y personalizada.
            </p>

            <div class="flex flex-col sm:flex-row gap-4">
                <a
                    href="#contacto"
                    class="bg-[#e5007d] hover:bg-[#c4006b] text-white text-center font-bold px-7 py-3.5 rounded-xl transition shadow-lg shadow-[#e5007d]/30"
                >
                    Agenda tu cita
                </a>

                <a
                    href="tel:3112131914"
                    class="border-2 border-slate-900 text-slate-900 hover:bg-slate-900 hover:text-white text-center font-bold px-7 py-3.5 rounded-xl transition"
                >
                    Llamar al 311 2131914
                </a>
            </div>
        </div>

        <!-- Tarjeta Visual de Compromiso -->
        <div class="bg-white p-8 rounded-3xl shadow-xl border border-slate-100">
            <div class="bg-[#0f172a] text-white p-6 rounded-2xl mb-6">
                <p class="text-xs uppercase tracking-wider text-[#e5007d] font-bold mb-1">
                    COMPROMISO SDENT
                </p>

                <p class="text-lg font-bold">
                    "Nos importa tu salud, nos importa tu sonrisa."
                </p>
            </div>

            <div class="space-y-4">
                <div class="flex items-center gap-3 p-3.5 bg-slate-50 rounded-xl">
                    <span class="w-3 h-3 rounded-full bg-[#e5007d] shrink-0"></span>

                    <span class="text-sm font-semibold text-slate-700">
                        Alivia el dolor desde la primera cita
                    </span>
                </div>

                <div class="flex items-center gap-3 p-3.5 bg-slate-50 rounded-xl">
                    <span class="w-3 h-3 rounded-full bg-[#00a3e0] shrink-0"></span>

                    <span class="text-sm font-semibold text-slate-700">
                        Conservamos tu diente natural
                    </span>
                </div>

                <div class="flex items-center gap-3 p-3.5 bg-slate-50 rounded-xl">
                    <span class="w-3 h-3 rounded-full bg-[#e5007d] shrink-0"></span>

                    <span class="text-sm font-semibold text-slate-700">
                        Tecnología de alta precisión
                    </span>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. Sección de Video -->
    <section class="max-w-5xl mx-auto my-8 px-6">
        <div class="relative w-full aspect-video rounded-3xl overflow-hidden shadow-2xl border border-slate-200">
            <div class="absolute inset-0 bg-slate-900/30 flex items-end p-6 md:p-10">
                <p class="text-white font-bold text-xl md:text-2xl drop-shadow-md">
                    Tecnología de vanguardia y atención especializada
                </p>
            </div>
        </div>
    </section>

    <!-- 4. Barra de Beneficios -->
    <section class="bg-[#0f172a] text-white py-6">
        <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
            <div class="flex items-center justify-center gap-3">
                <span class="text-[#e5007d] font-black text-xl">✓</span>

                <span class="text-sm font-semibold">
                    Profesionales Especializados
                </span>
            </div>

            <div class="flex items-center justify-center gap-3">
                <span class="text-[#00a3e0] font-black text-xl">✓</span>

                <span class="text-sm font-semibold">
                    Materiales de Alta Calidad
                </span>
            </div>

            <div class="flex items-center justify-center gap-3">
                <span class="text-[#e5007d] font-black text-xl">✓</span>

                <span class="text-sm font-semibold">Resultados duraderos</span>
            </div>
        </div>
    </section>

    <!-- 5. Footer -->
    <footer id="contacto" class="bg-white border-t border-slate-200 py-10">
        <div class="max-w-7xl mx-auto px-6 text-center">
            <p class="text-xl font-extrabold text-slate-900 mb-1">
                sDent Odontología Especializada
            </p>

            <p class="text-sm text-slate-500 mb-4">
                Bogotá, Colombia • Teléfono: 311 2131914
            </p>

            <p class="text-xs text-slate-400">
                © 2026 sDent. Todos los derechos reservados.
            </p>
        </div>
    </footer>
</div>
