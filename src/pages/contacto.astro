---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';
---

<Layout title="Contacto - Odontología">
  <Header />
  <main class="max-w-7xl mx-auto px-6 py-12">
    <h1 class="text-4xl font-bold text-slate-800 mb-4">Ubicación y Contacto</h1>
    <p class="text-slate-600 text-lg">Números de teléfono, mapa y horarios.</p>
  </main>
</Layout>