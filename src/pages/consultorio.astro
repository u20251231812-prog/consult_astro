---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Consultorio y Contacto - SDent">

  <main class="bg-slate-50 min-h-screen py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-6 space-y-12">
      
      <!-- Encabezado de la Sección -->
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900">
          Nuestro Consultorio
        </h1>
        <p class="text-slate-600 text-lg">
        </p>
      </div>

      <!-- Cuadrícula Principal: Información + Mapa Interactivo -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Tarjeta de Datos de Contacto (Izquierda) -->
        <div class="lg:col-span-5 bg-white p-8 rounded-2xl border border-slate-200 shadow-sm space-y-6">
          <h2 class="text-2xl font-bold text-slate-900 border-b border-slate-100 pb-4">
            Información de Atención
          </h2>

          <!-- Ítem: Dirección -->
          <div class="flex items-start gap-4">
            <div class="p-3 bg-slate-100 rounded-xl text-[#01B4FF]">
              <!-- Icono Ubicación -->
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-slate-900"></h3>
              <p class="text-slate-600 text-sm"></p>
              <p class="text-slate-500 text-xs mt-0.5"></p>
            </div>
          </div>

          <!-- Ítem: Teléfonos / WhatsApp -->
          <div class="flex items-start gap-4">
            <div class="p-3 bg-slate-100 rounded-xl text-[#01B4FF]">
              <!-- Icono Teléfono -->
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-slate-900"></h3>
              <p class="text-slate-600 text-sm"></p>
              <p class="text-slate-500 text-xs mt-0.5"></p>
            </div>
          </div>

          <!-- Ítem: Horarios -->
          <div class="flex items-start gap-4">
            <div class="p-3 bg-slate-100 rounded-xl text-[#01B4FF]">
              <!-- Icono Reloj -->
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-slate-900"></h3>
              <p class="text-slate-600 text-sm"></p>
              <p class="text-slate-600 text-sm"></p>
            </div>
          </div>
        </div>

        <!-- Columna Derecha: Mapa Interactivo de Google Maps -->
        <div class="lg:col-span-7 bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
          <div class="w-full h-112.5 rounded-xl overflow-hidden shadow-inner border border-slate-100">
            <iframe 
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d127453.64096081525!2d-75.3524677271911!3d2.934812328103758!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e3b747d3d2a09c3%3A0x6b4bf2b220b3c3f9!2sNeiva%2C%20Huila!5e0!3m2!1ses!2sco!4v1700000000000!5m2!1ses!2sco" 
              class="w-full h-full border-0" 
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>

      </div>

    </div>
  </main>
</Layout>