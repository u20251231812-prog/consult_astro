---
import Header from '../components/Header.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro'; // 1. Importar
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-50 text-slate-900">
    <slot />
    
    <!-- 2. Colocar aquí para que se renderice en todas las páginas -->
    <WhatsAppButton />
  </body>
</html>